# Copie ce fichier en ".env" et remplis les valeurs. Ne jamais committer ".env" (voir .gitignore).

# --- Supabase (nouveau projet indépendant, pas Lovable Cloud) ---
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète — jamais exposée au client, jamais préfixée VITE_
SUPABASE_SERVICE_ROLE_KEY=

# Mêmes valeurs, exposées côté client par Vite (doivent rester des clés publiques uniquement)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- IA (Gemini direct, remplace le gateway Lovable) ---
# Clé gratuite : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optionnel — vérifier le modèle gratuit actuel sur https://ai.google.dev/gemini-api/docs/models
# GEMINI_TEXT_MODEL=gemini-2.5-flash
